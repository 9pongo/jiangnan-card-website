# 填入公司秘密管理服務或部署平台環境變數，不得提交真實值。
NODE_ENV=production
AUTH_MODE=oidc
DATABASE_URL=postgresql://<user>:<password>@<private-db-host>:5432/jiangnan_card
PUBLIC_ORIGIN=https://www.example.com
OIDC_ISSUER=https://login.company.example
OIDC_AUDIENCE=jiangnan-card-admin-api
ORDER_EXPIRY_TOKEN=<generate-a-random-secret-in-secret-manager>
ORDER_EXPIRY_ACTOR_ID=<pre-provisioned-users.id-for-scheduler>
ASSET_STORAGE_PROVIDER=s3
ASSET_BUCKET=<private-banner-bucket>
ASSET_PUBLIC_BASE_URL=https://cdn.example.com
ASSET_PREFIX=banners
AWS_REGION=ap-northeast-1
